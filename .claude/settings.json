{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm install*)",
      "Bash(pnpm add *)",
      "Bash(pnpm check*)",
      "Bash(pnpm test*)",
      "Bash(pnpm lint*)",
      "Bash(pnpm format*)",
      "Bash(pnpm typecheck*)",
      "Bash(pnpm run contracts:test*)",
      "Bash(pnpm run contracts:build*)",
      "Bash(pnpm run cases:gen)",
      "Bash(pnpm exec biome *)",
      "Bash(pnpm exec vitest *)",
      "Bash(pnpm exec tsc *)",
      "Bash(cargo test*)",
      "Bash(cargo build*)",
      "Bash(forge test*)",
      "Bash(forge build*)",
      "Bash(node --version)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(git switch *)",
      "Bash(git checkout -b *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git fetch*)",
      "Bash(ls *)",
      "Bash(tree *)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(git merge*)",
      "Bash(git tag*)",
      "Bash(git rebase*)",
      "Bash(gh pr *)",
      "Bash(gh repo *)",
      "Bash(pnpm deploy:*)",
      "Bash(pnpm run deploy:*)",
      "Bash(pnpm settle *--live*)",
      "Bash(pnpm run settle *--live*)",
      "Bash(pnpm release-stale*)",
      "Bash(pnpm run release-stale*)",
      "Bash(pnpm remove *)",
      "Bash(pnpm --filter *)",
      "Bash(stellar contract deploy*)",
      "Bash(stellar contract invoke*)",
      "Bash(stellar contract upload*)",
      "Bash(forge script *)",
      "Bash(forge create*)",
      "Bash(cast send*)",
      "Bash(pnpm bootstrap*)",
      "Bash(pnpm run bootstrap*)",
      "Bash(forge install*)",
      "Bash(forge update*)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.production)",
      "Read(**/.env.development)",
      "Bash(cat *.env*)",
      "Bash(head *.env*)",
      "Bash(tail *.env*)",
      "Bash(less *.env*)",
      "Bash(more *.env*)",
      "Bash(grep *.env*)",
      "Bash(sed *.env*)",
      "Bash(source *.env*)",
      "Bash(. *.env*)",
      "Bash(git add -A*)",
      "Bash(git add --all*)",
      "Bash(git add .)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push *--force*)",
      "Bash(git push * -f*)",
      "Bash(git reset --hard*)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -r -f *)",
      "Bash(rm -f -r *)"
    ]
  }
}
