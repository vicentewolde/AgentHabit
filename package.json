{
  "name": "agenthabit",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "biome check . && tsc -b && vitest run",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "contracts:test:stellar": "cargo test --manifest-path contracts/stellar/Cargo.toml",
    "contracts:test:evm": "forge test --root contracts/evm",
    "contracts:test": "pnpm run contracts:test:stellar && pnpm run contracts:test:evm"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "22.20.5",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  }
}
