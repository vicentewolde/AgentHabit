{
  "name": "agenthabit",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "biome check . && tsc -b && vitest run",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "contracts:test:stellar": "cd contracts/stellar && cargo test --locked",
    "contracts:test:evm": "forge test --root contracts/evm",
    "contracts:test": "pnpm run contracts:test:stellar && pnpm run contracts:test:evm",
    "contracts:build:stellar": "cd contracts/stellar && stellar contract build --locked",
    "contracts:build:evm": "forge build --root contracts/evm",
    "cases:gen": "tsx --conditions=@agenthabit/source scripts/gen-cases.ts",
    "db:generate": "pnpm --filter @agenthabit/db run db:generate",
    "db:migrate": "tsx --conditions=@agenthabit/source packages/db/src/migrate.ts",
    "api:dev": "tsx --conditions=@agenthabit/source apps/api/src/server.ts",
    "api:start": "tsx --conditions=@agenthabit/source apps/api/src/server.ts",
    "bootstrap": "tsx --conditions=@agenthabit/source scripts/bootstrap.ts",
    "deploy:stellar": "tsx --conditions=@agenthabit/source scripts/deploy-stellar.ts",
    "smoke:stellar": "tsx --conditions=@agenthabit/source scripts/smoke-stellar.ts",
    "web:dev": "pnpm --filter @agenthabit/web run dev",
    "web:mock-api": "pnpm --filter @agenthabit/web run mock-api"
  },
  "devDependencies": {
    "@agenthabit/chain-stellar": "workspace:*",
    "@agenthabit/config": "workspace:*",
    "@agenthabit/core": "workspace:*",
    "@biomejs/biome": "2.5.15",
    "@stellar/stellar-sdk": "17.2.1",
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "viem": "2.57.7",
    "vitest": "5.0.4",
    "zod": "4.6.7"
  }
}
