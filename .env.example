# AgentHabit environment. `pnpm run bootstrap` copies this file to `.env.local`
# (git-ignored, mode 0600) on its first run and fills in the keys, which are never
# passed on the command line or printed. Never commit real values.

# --- Settlement --------------------------------------------------------------
# dry-run (default): the oracle computes and prints, but signs nothing.
# live: signs `settle` and `release_if_stale`, and only when the command also passes --live
# (A-7). Only with the user's explicit instruction.
SETTLE_MODE=dry-run

# --- Stellar testnet (Phase 1) ------------------------------------------------
# Soroban RPC. Verify against the official docs before use.
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
# Secret keys (S...), generated by bootstrap (T2): deployer, oracle and a test user.
STELLAR_DEPLOYER_SECRET=
STELLAR_ORACLE_SECRET=
STELLAR_TEST_USER_SECRET=

# --- Avalanche Fuji (Phase 1, chainId 43113) ------------------------------------
AVALANCHE_FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
# Private keys (0x...), generated by bootstrap (T2): deployer, oracle and a test user.
AVALANCHE_DEPLOYER_PRIVATE_KEY=
AVALANCHE_ORACLE_PRIVATE_KEY=
AVALANCHE_TEST_USER_PRIVATE_KEY=

# --- Strava (T5) -----------------------------------------------------------------
# From the Strava API app settings (requires a Strava subscription since 2026-06-01).
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# OAuth callback: localhost in Phase 1 (T5 fixes the exact port and path).
STRAVA_REDIRECT_URI=http://localhost:3000/auth/strava/callback
# Key used to encrypt stored Strava tokens at rest (T5 defines its format).
TOKEN_ENCRYPTION_KEY=

# --- Database (T5) ---------------------------------------------------------------
# Neon Postgres connection string.
DATABASE_URL=
